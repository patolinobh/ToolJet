# Copie este arquivo para .env e preencha os valores:
#   cp env.example .env
#
# Gere os segredos com:
#   openssl rand -hex 32   → LOCKBOX_MASTER_KEY e PGRST_JWT_SECRET
#   openssl rand -hex 64   → SECRET_KEY_BASE

# --- Endereço público do app ---
# Subdomínio gratuito: crie em https://www.duckdns.org e aponte para o IP da VM.
TOOLJET_DOMINIO=SEU-SUBDOMINIO.duckdns.org
TOOLJET_HOST=https://SEU-SUBDOMINIO.duckdns.org

# --- Segredos (obrigatórios; gere com openssl, não use os exemplos) ---
LOCKBOX_MASTER_KEY=TROQUE_POR_openssl_rand_hex_32
SECRET_KEY_BASE=TROQUE_POR_openssl_rand_hex_64
PGRST_JWT_SECRET=TROQUE_POR_openssl_rand_hex_32

# --- Banco de dados (interno ao docker compose) ---
PG_USER=postgres
PG_PASS=TROQUE_POR_UMA_SENHA_FORTE
PG_DB=tooljet_production
PG_PORT=5432

# --- ToolJet Database (tabela do histórico de consultas) ---
TOOLJET_DB=tooljet_db
TOOLJET_DB_USER=postgres
TOOLJET_DB_PASS=MESMA_SENHA_DO_PG_PASS
TOOLJET_DB_HOST=postgres

# --- Diversos ---
CHECK_FOR_UPDATES=false
DISABLE_TOOLJET_TELEMETRY=true
SMTP_DISABLED=true
